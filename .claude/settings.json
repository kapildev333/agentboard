{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "workflowSizeGuideline": "large",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "40"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git rebase *)",
      "Bash(git push -u origin lane/*)",
      "Bash(git push origin lane/*)",
      "Bash(git worktree *)",
      "Bash(git branch*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list*)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(scripts/*.sh*)",
      "Bash(./scripts/*.sh*)",
      "Bash(claude agents*)",
      "Bash(claude logs *)",
      "Bash(claude rm *)",
      "Bash(claude --bg *)",
      "Bash(claude --resume *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(git push -u origin HEAD*)",
      "Bash(git push origin HEAD*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.npmrc)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(gh auth *)",
      "Bash(security *)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(npm publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(sudo *)",
      "Bash(docker *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh edit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
