{
  "name": "agentboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "fix-pty": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build -w packages/shared && npm run build --workspaces --if-present",
    "test:e2e": "npm run build && npm run -w @agentboard/e2e test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "version": "0.1.0"
}
